{
  "name": "tag-forge",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A deterministic, graph-assisted game idea generator for indie developers and game jams.",
  "scripts": {
    "dev": "vite",
    "build": "pnpm data:validate && pnpm typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "data:validate": "node scripts/validate-data.mjs",
    "data:fetch": "node scripts/fetch-tags.mjs",
    "simulate": "tsx scripts/simulate.ts",
    "check": "pnpm data:validate && pnpm typecheck && pnpm test && pnpm build",
    "deploy:pages": "powershell -ExecutionPolicy Bypass -File scripts/publish-pages.ps1"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.2.8",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "d3-force": "^3.0.0",
    "lucide-react": "^0.468.0",
    "motion": "^11.15.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/d3-force": "^3.0.10",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.19.2",
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  },
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=20"
  }
}
