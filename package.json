{
  "name": "tag-forge",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A deterministic, data-pack-driven game idea generator for indie developers and game jams.",
  "scripts": {
    "predev": "pnpm pack:build && pnpm analysis:build",
    "dev": "vite",
    "build": "pnpm pack:build && pnpm pack:validate && pnpm analysis:build && pnpm typecheck && vite build",
    "build:app": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "pack:build": "node scripts/build-packs.mjs",
    "pack:validate": "node --import tsx scripts/validate-pack.ts",
    "analysis:build": "node scripts/build-analysis.mjs",
    "analysis:verify": "node scripts/build-analysis.mjs --verify",
    "data:validate": "pnpm pack:validate",
    "data:prompt-similarity": "node scripts/validate-prompt-similarity.mjs",
    "data:fetch": "node scripts/fetch-tags.mjs",
    "data:jam-reference": "node scripts/build-jam-reference.mjs",
    "data:suggest": "node scripts/suggest-tags.mjs",
    "data:report": "node scripts/report-data.mjs",
    "data:prepare": "pnpm data:fetch && pnpm data:jam-reference && pnpm data:suggest && pnpm data:report",
    "data:simulate": "pnpm simulate -- --count=2000",
    "data:verify": "pnpm pack:build && pnpm pack:validate && pnpm data:report && pnpm data:prompt-similarity && pnpm data:simulate && pnpm analysis:build && pnpm analysis:verify && pnpm typecheck && pnpm test && pnpm build:app && pnpm test:e2e",
    "simulate": "tsx scripts/simulate.ts",
    "check": "pnpm pack:build && pnpm pack:validate && pnpm analysis:build && pnpm analysis:verify && pnpm data:simulate && pnpm typecheck && pnpm test && pnpm build:app && pnpm test:e2e"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.2.8",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "d3-force": "^3.0.0",
    "fflate": "^0.8.3",
    "idb": "^8.0.3",
    "lucide-react": "^0.468.0",
    "motion": "^11.15.0",
    "papaparse": "^5.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/d3-force": "^3.0.10",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "fake-indexeddb": "^6.2.5",
    "graphology": "^0.26.0",
    "graphology-communities-louvain": "^2.0.2",
    "graphology-metrics": "^2.4.0",
    "tsx": "^4.19.2",
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  },
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=20"
  }
}
